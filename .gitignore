# Brew Updates - .gitignore

# Generated log files and runtime data
*.log
*.log.*
.brew_logs/
.brew_backups/

# macOS specific files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Temporary files
*.tmp
*.temp
*~
.#*
#*#

# User configuration files (these should not be shared)
.brew_update_config
config.local
.env.local

# User-specific LaunchAgent plist (use .sample file as template)
com.user.brew-update.plist
com.jxman.brew-updates.plist

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo

# Backup files
*.bak
*.backup
*.old

# Test files and directories
test_*.sh
tests/tmp/
*.test

# Package manager files (if any)
node_modules/
*.tgz
*.tar.gz

# Runtime and cache directories
cache/
tmp/

# Operating system generated files
*.pid
*.lock

# Documentation build artifacts
docs/_build/
site/

# Personal notes and TODO files (not the project CHANGELOG)
TODO.txt
NOTES.txt
personal_notes.md

# Local development scripts
dev_*
local_*
*.dev

# Certificates and keys (security)
*.pem
*.key
*.crt
*.csr
*.cer
*.p12
*.p8
*.mobileprovision
*.provisionprofile
# Sparkle EdDSA private key export (generate_keys -x, docs/DEPLOYMENT.md)
*sparkle-key*
*sparkle_key*

# Environment files (keep the example)
.env
.env.*
!.env.example

# Claude Code per-user settings
.claude/settings.local.json

# Any local configuration overrides
local.config
*.local.conf
# Snyk Security Extension - AI Rules (auto-generated)
.github/instructions/snyk_rules.instructions.md

# SwiftUI app (app/) - the Xcode project is generated from app/project.yml by XcodeGen
app/*.xcodeproj/
app/build/
xcuserdata/
DerivedData/
*.xcresult
*.xcarchive
.build/
.swiftpm/
*.dmg

# Generated by XcodeGen from app/project.yml (target info)
app/BrewUpdates/App/Info.plist

# Zips made by scripts/install-app.sh --package
dist/

# ggshield (GitGuardian) local cache
.cache_ggshield
